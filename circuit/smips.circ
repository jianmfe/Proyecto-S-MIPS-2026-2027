  <vhdl appearance="logisim_evolution" name="Register_File">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity Register_File is
    port (
        -- Control y sincronizacion
        CLK        : in  std_logic;
        RESET      : in  std_logic;
        REG_WRITE  : in  std_logic;

        -- Puerto de Lectura 1
        READ_ADDR1 : in  std_logic_vector(4 downto 0);
        READ_DATA1 : out std_logic_vector(31 downto 0);

        -- Puerto de Lectura 2
        READ_ADDR2 : in  std_logic_vector(4 downto 0);
        READ_DATA2 : out std_logic_vector(31 downto 0);

        -- Puerto de Escritura
        WRITE_ADDR : in  std_logic_vector(4 downto 0);
        WRITE_DATA : in  std_logic_vector(31 downto 0)
    );
end entity Register_File;

architecture RTL of Register_File is

    -- Array de 31 registros de 32 bits (el registro 0 se maneja de forma especial)
    type register_array is array (1 to 31) of std_logic_vector(31 downto 0);
    signal registers : register_array := (others =&gt; (others =&gt; '0'));

begin

    -- Proceso secuencial: Escritura sincrona y reset (R6)
    process (CLK)
    begin
        if rising_edge(CLK) then
            if RESET = '1' then
                registers     &lt;= (others =&gt; (others =&gt; '0'));
                registers(28) &lt;= x"00001800"; -- $gp inicial
                registers(29) &lt;= x"00003FFC"; -- $sp inicial
            elsif REG_WRITE = '1' then
                if unsigned(WRITE_ADDR) /= 0 then
                    registers(to_integer(unsigned(WRITE_ADDR))) &lt;= WRITE_DATA;
                end if;
            end if;
        end if;
    end process;

    -- Puerto de Lectura 1: Combinacional con proteccion estricta para $zero
    process (READ_ADDR1, registers)
    begin
        if unsigned(READ_ADDR1) = 0 then
            READ_DATA1 &lt;= (others =&gt; '0');
        else
            READ_DATA1 &lt;= registers(to_integer(unsigned(READ_ADDR1)));
        end if;
    end process;

    -- Puerto de Lectura 2: Combinacional con proteccion estricta para $zero
    process (READ_ADDR2, registers)
    begin
        if unsigned(READ_ADDR2) = 0 then
            READ_DATA2 &lt;= (others =&gt; '0');
        else
            READ_DATA2 &lt;= registers(to_integer(unsigned(READ_ADDR2)));
        end if;
    end process;

end architecture RTL;</vhdl>
  <vhdl appearance="logisim_evolution" name="ALU">library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

entity ALU is
    port (
        A      : in  std_logic_vector(31 downto 0);
        B      : in  std_logic_vector(31 downto 0);
        ALU_OP : in  std_logic_vector(2 downto 0);
        RESULT : out std_logic_vector(31 downto 0);
        ZERO   : out std_logic
    );
end entity ALU;

architecture RTL of ALU is
begin
    process(A, B, ALU_OP)
        variable signed_a     : signed(31 downto 0);
        variable signed_b     : signed(31 downto 0);
        variable unsigned_b   : unsigned(31 downto 0);
        variable res_internal : std_logic_vector(31 downto 0);
        variable shift_amt    : integer range 0 to 31;
    begin
        -- Conversiones explícitas para operaciones con y sin signo
        signed_a     := signed(A);
        signed_b     := signed(B);
        unsigned_b   := unsigned(B);
        
        -- Extracción del factor de desplazamiento (shamt) desde los bits bajos de B
        shift_amt    := to_integer(unsigned(B(4 downto 0)));
        
        res_internal := (others =&gt; '0');

        case ALU_OP is
            when "000" =&gt; -- Suma (add, addi, addu, addiu, lw, sw, cálculo de direcciones)
                res_internal := std_logic_vector(signed_a + signed_b);
                
            when "001" =&gt; -- Resta (sub, beq, bne)
                res_internal := std_logic_vector(signed_a - signed_b);
                
            when "010" =&gt; -- Comparación con signo (slt, slti)
                if signed_a &lt; signed_b then
                    res_internal := x"00000001";
                else
                    res_internal := x"00000000";
                end if;
                
            when "011" =&gt; -- Operación AND lógico (and, andi)
                res_internal := A and B;
                
            when "100" =&gt; -- Operación OR lógico (or, ori)
                res_internal := A or B;
                
            when "101" =&gt; -- Desplazamiento lógico a la izquierda (sll)
                res_internal := std_logic_vector(shift_left(unsigned_b, shift_amt));
                
            when "110" =&gt; -- Desplazamiento lógico a la derecha (srl, entran ceros)
                res_internal := std_logic_vector(shift_right(unsigned_b, shift_amt));
                
            when others =&gt;
                res_internal := (others =&gt; '0');
        end case;

        -- Asignación de la salida de resultado
        RESULT &lt;= res_internal;

        -- Generación de la bandera ZERO requerida por la arquitectura[span_4](start_span)[span_4](end_span)
        if res_internal = x"00000000" then
            ZERO &lt;= '1';
        else
            ZERO &lt;= '0';
        end if;
    end process;

end architecture RTL;</vhdl>
</project>
